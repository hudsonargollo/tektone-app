{
  "expo": {
    "name": "TaskTone",
    "slug": "tasktone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasktone",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#efe8dc",
    "ios": {
      "bundleIdentifier": "br.com.tektone.tasktone"
    },
    "android": {
      "package": "br.com.tektone.tasktone",
      "adaptiveIcon": {
        "backgroundColor": "#efe8dc",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TaskTone usa suas fotos para definir o avatar do seu perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#efe8dc",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
